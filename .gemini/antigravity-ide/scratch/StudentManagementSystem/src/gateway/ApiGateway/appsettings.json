{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-exact": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/auth"
        }
      },
      "auth-sub": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "students-exact": {
        "ClusterId": "studentCluster",
        "Match": {
          "Path": "/api/v1/students"
        }
      },
      "students-sub": {
        "ClusterId": "studentCluster",
        "Match": {
          "Path": "/api/v1/students/{**remainder}"
        }
      },
      "courses-exact": {
        "ClusterId": "courseCluster",
        "Match": {
          "Path": "/api/v1/courses"
        }
      },
      "courses-sub": {
        "ClusterId": "courseCluster",
        "Match": {
          "Path": "/api/v1/courses/{**remainder}"
        }
      },
      "enrollments-exact": {
        "ClusterId": "enrollmentCluster",
        "Match": {
          "Path": "/api/v1/enrollments"
        }
      },
      "enrollments-sub": {
        "ClusterId": "enrollmentCluster",
        "Match": {
          "Path": "/api/v1/enrollments/{**remainder}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service:80"
          }
        }
      },
      "studentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://student-service:80"
          }
        }
      },
      "courseCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://course-service:80"
          }
        }
      },
      "enrollmentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://enrollment-service:80"
          }
        }
      }
    }
  }
}
